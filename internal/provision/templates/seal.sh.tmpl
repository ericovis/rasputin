#!/bin/sh
# rasputin-seal — strip a node of everything that must be unique before its
# card is captured as the golden image.
#
# Run over SSH by `rasputin bake`, immediately before the capture. It does
# not reboot: the CLI decides what happens next.
set -u

log() {
    echo "rasputin: $*" > /dev/kmsg 2>/dev/null || true
    echo "rasputin: $*"
}

ROOTFS_CAP_GB={{.RootfsSizeGB}}

# --- fit check: refuse to capture a rootfs that does not fit the cap ---------
# This runs FIRST, before anything is stripped: an aborted seal leaves the
# builder exactly as provisioned — bootable, reachable, host keys and
# machine-id intact — so the fix is to raise image.rootfs_size_gb or trim
# provision.packages and simply re-run bake. The measurement still includes
# the apt lists and journal this script would have cleaned (~300 MB); the
# margin covers that.
cap_bytes=$((ROOTFS_CAP_GB * 1024 * 1024 * 1024))
margin_bytes=$((512 * 1024 * 1024))
used_kb=$(df -Pk / | awk 'NR==2 {print $3}')
[ -n "$used_kb" ] || { echo "rasputin-seal: ABORT: cannot measure / usage (df -Pk / gave no row). Nothing was changed." >&2; exit 1; }
used_bytes=$((used_kb * 1024))
if [ "$used_bytes" -gt "$((cap_bytes - margin_bytes))" ]; then
    echo "rasputin-seal: ABORT: / uses ${used_bytes} bytes; the ${ROOTFS_CAP_GB} GiB cap allows at most $((cap_bytes - margin_bytes)) (cap minus a 512 MiB margin). Nothing was changed. Raise image.rootfs_size_gb or trim provision.packages, re-run prepare, and bake again." >&2
    log "seal: ABORT: rootfs does not fit the ${ROOTFS_CAP_GB} GiB cap (used ${used_bytes} bytes)"
    exit 1
fi
log "seal: rootfs uses ${used_bytes} of ${cap_bytes} capped bytes; fits with >=512 MiB margin"

log "seal: removing SSH host keys"
rm -f /etc/ssh/ssh_host_*

log "seal: truncating machine-id"
: > /etc/machine-id
rm -f /var/lib/dbus/machine-id

# The provisioning marker is deliberately LEFT in place: the package set is
# already installed in this image, so a clone re-running apt would only cost
# time and require the internet to boot cleanly.

log "seal: vacuuming the journal"
journalctl --rotate >/dev/null 2>&1 || true
journalctl --vacuum-time=1s >/dev/null 2>&1 || true

log "seal: clearing logs, apt lists and shell history"
rm -rf /var/lib/apt/lists/* /var/log/*.gz /var/log/*.1 2>/dev/null || true
find /var/log -type f -name '*.log' -exec truncate -s0 {} + 2>/dev/null || true
rm -f /root/.bash_history /home/*/.bash_history 2>/dev/null || true

# --- zero the free space -----------------------------------------------------
# A capture streams the whole used prefix of the card, deleted files and all,
# so whatever stale bytes sit in the free space are what the compressor has to
# encode. Zeroing them first is what makes the golden image small.
#
# This used to be skipped on the assumption that it meant writing tens of
# gigabytes to the flash: it does not. firstrun grows the builder's rootfs only
# to the cap (ROOTFS_CAP_GB), so at most cap-minus-used is written — a couple
# of GB — and every later flash carries the saving.
#
# The guard is the safety: a builder whose rootfs somehow is not at the cap
# (grown to a whole 32 GB card by an older image, say) would write tens of
# gigabytes to the flash for nothing, so it skips instead.
fs_kb=$(df -Pk / | awk 'NR==2 {print $2}')
max_kb=$(( (cap_bytes / 1024) + (cap_bytes / 1024 / 10) ))
if [ -z "$fs_kb" ] || [ "$fs_kb" -gt "$max_kb" ]; then
    log "seal: / is ${fs_kb:-unknown} KiB, more than the ${ROOTFS_CAP_GB} GiB cap plus 10% — skipping the zero fill"
else
    log "seal: filling the free space of / with zeros"
    dd if=/dev/zero of=/rasputin-zero bs=4M status=none 2>/dev/null || true
    zeroed_kb=$(du -k /rasputin-zero 2>/dev/null | awk '{print $1}')
    sync
    rm -f /rasputin-zero
    sync
    log "seal: zeroed ${zeroed_kb:-0} KiB of free space"
fi

# Arm the one-shot writable layer: on the next real boot rasputin-identity
# appends p3 over the rest of the card and reboots into the overlay, but only
# when this marker exists. It is created here, immediately before capture,
# precisely so it gets baked into the golden image — the builder never sees it
# between firstrun and seal, so captures stay at the cap.
log "seal: arming the clone's writable layer"
mkdir -p /var/lib/rasputin
: > /var/lib/rasputin/grow-rootfs

sync
log "seal: complete"
exit 0
