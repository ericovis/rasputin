#!/bin/sh
# udhcpc callback — minimal interface configuration for the recovery initramfs.
# udhcpc exports: $interface $ip $subnet $router $dns
case "$1" in
    deconfig)
        ifconfig "$interface" 0.0.0.0
        ;;
    bound|renew)
        ifconfig "$interface" "$ip" netmask "${subnet:-255.255.255.0}"
        if [ -n "${router:-}" ]; then
            route del default 2>/dev/null
            route add default gw "${router%% *}" dev "$interface"
        fi
        : > /etc/resolv.conf
        for d in ${dns:-}; do
            echo "nameserver $d" >> /etc/resolv.conf
        done
        ;;
esac
exit 0
