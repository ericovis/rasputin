#!/bin/sh
# /init — busybox recovery initramfs for the rasputin Pi 3 cluster.
#
# Every boot passes through here (config.txt: `initramfs recovery.gz followkernel`).
#
#   no flag file                  -> switch_root into the real rootfs (normal boot)
#   /boot/firmware/reflash        -> stream base image over HTTP, dd the whole SD
#                                    card (we are RAM-resident), hard reboot
#   /boot/firmware/reflash-dryrun -> same pipeline but dd to /dev/null; writes a
#                                    report to /boot/firmware/reflash-dryrun.log,
#                                    removes the flag, reboots normally
#
# The flag file's first line, if non-empty, overrides the image URL (reflash.sh
# writes its ephemeral server's URL there). Empty flag -> baked-in default.
#
# Safety: the card is not opened for writing until an HTTP probe of the URL
# succeeds, and zstd only emits data after a valid frame header arrives — so a
# dead/misconfigured server leaves the card intact and the node retries forever.
# A failure mid-dd loops back to retry the full stream (RAM-resident, no brick).
# Everything is logged to the kernel ring buffer (/dev/kmsg) for post-mortem.

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox --install -s

DISK=/dev/mmcblk0
BOOT_PART=/dev/mmcblk0p1        # Pi 3, SD only: device names are fixed
ROOT_PART=/dev/mmcblk0p2
DEFAULT_URL="@DEFAULT_URL@"     # substituted by build.sh from cluster.conf

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || mdev -s

log() {
    echo "recovery: $*" > /dev/kmsg 2>/dev/null
    echo "recovery: $*"
}

fatal_shell() {
    log "FATAL: $*  — dropping to shell on console"
    exec sh
}

# --- wait for the SD card ----------------------------------------------------
n=0
while [ ! -b "$BOOT_PART" ] || [ ! -b "$ROOT_PART" ]; do
    n=$((n + 1))
    [ "$n" -gt 50 ] && fatal_shell "SD card partitions never appeared"
    usleep 200000
done

# --- read flag files from the boot partition ---------------------------------
MODE=normal
URL="$DEFAULT_URL"
mount -o ro "$BOOT_PART" /mnt/boot || fatal_shell "cannot mount $BOOT_PART"
if [ -f /mnt/boot/reflash-dryrun ]; then       # dryrun wins: a test must never wipe
    MODE=dryrun
    u=$(head -n1 /mnt/boot/reflash-dryrun)
elif [ -f /mnt/boot/reflash ]; then
    MODE=reflash
    u=$(head -n1 /mnt/boot/reflash)
fi
[ -n "${u:-}" ] && URL="$u"
umount /mnt/boot

# =============================================================================
# Normal boot: hand over to the real system
# =============================================================================
if [ "$MODE" = normal ]; then
    n=0
    until mount -o ro "$ROOT_PART" /mnt/root; do
        n=$((n + 1))
        [ "$n" -ge 3 ] && fatal_shell "cannot mount rootfs $ROOT_PART"
        sleep 1
    done
    umount /sys
    umount /proc
    mount -o move /dev /mnt/root/dev 2>/dev/null || umount /dev 2>/dev/null
    exec switch_root /mnt/root /sbin/init
    fatal_shell "switch_root failed"
fi

# =============================================================================
# Reflash / dryrun path — from here on we live entirely in RAM
# =============================================================================
MAC=$(cat /sys/class/net/eth0/address 2>/dev/null)
log "mode=$MODE mac=${MAC:-unknown} url=$URL"

# --- bring up eth0 via DHCP --------------------------------------------------
n=0
while [ ! -e /sys/class/net/eth0 ]; do
    n=$((n + 1))
    [ $((n % 10)) -eq 0 ] && log "still waiting for eth0 (${n}s) — driver missing?"
    sleep 1
done
ip link set lo up
ip link set eth0 up
until udhcpc -i eth0 -n -q -t 5 -T 3 -s /etc/udhcpc.script >/dev/null 2>&1; do
    log "DHCP failed on eth0, retrying in 3s"
    sleep 3
done
log "eth0 up: $(ip -4 -o addr show eth0 | tr -s ' ' | cut -d' ' -f4)"

# --- download/flash pipeline -------------------------------------------------
probe() {
    wget -q --spider -T 10 "$URL" 2>/dev/null
}

# probe_wait <max_tries|0=forever>; returns 1 if tries exhausted
probe_wait() {
    max=$1 try=0 backoff=2
    until probe; do
        try=$((try + 1))
        [ "$max" -gt 0 ] && [ "$try" -ge "$max" ] && return 1
        log "image server not reachable ($URL), retry in ${backoff}s (card untouched)"
        sleep "$backoff"
        backoff=$((backoff * 2))
        [ "$backoff" -gt 60 ] && backoff=60
    done
    return 0
}

# stream <target> [dd-conv-args] — wget | zstd -d | dd, capturing each stage's
# exit status via files (busybox sh has no PIPESTATUS)
stream() {
    target=$1
    conv=${2:-}
    rm -f /tmp/s.wget /tmp/s.zstd /tmp/s.dd /tmp/dd.err /tmp/zstd.err
    { wget -q -O - -T 30 "$URL" 2>/dev/null; echo $? > /tmp/s.wget; } \
      | { zstd -dc 2> /tmp/zstd.err;         echo $? > /tmp/s.zstd; } \
      | { dd of="$target" bs=4M $conv 2> /tmp/dd.err; echo $? > /tmp/s.dd; }
    sleep 1   # let the earlier pipe stages finish writing their status files
    W=$(cat /tmp/s.wget 2>/dev/null)
    Z=$(cat /tmp/s.zstd 2>/dev/null)
    D=$(cat /tmp/s.dd   2>/dev/null)
    DD_MSG=$(tail -n1 /tmp/dd.err 2>/dev/null)
    ZSTD_MSG=$(tail -n1 /tmp/zstd.err 2>/dev/null)
    [ "$W" = 0 ] && [ "$Z" = 0 ] && [ "$D" = 0 ]
}

now() { cut -d. -f1 /proc/uptime; }

# =============================================================================
# Real reflash: retry forever, only a fully successful pass reboots
# =============================================================================
if [ "$MODE" = reflash ]; then
    attempt=0
    while :; do
        attempt=$((attempt + 1))
        probe_wait 0
        log "attempt $attempt: streaming $URL -> $DISK"
        t0=$(now)
        if stream "$DISK" conv=fsync; then
            t1=$(now)
            sync
            log "flash OK in $((t1 - t0))s — $DD_MSG"
            log "rebooting into fresh image"
            reboot -f
        fi
        log "attempt $attempt FAILED (wget=$W zstd=$Z dd=$D) ${ZSTD_MSG:+zstd: $ZSTD_MSG }${DD_MSG:+dd: $DD_MSG}"
        log "card may be partially written; retrying (recovery is RAM-resident)"
        sleep 5
    done
fi

# =============================================================================
# Dryrun: 3 attempts against /dev/null, report to boot partition, boot normally
# =============================================================================
RESULT="FAILED after 3 attempts"
for attempt in 1 2 3; do
    if ! probe_wait 5; then
        RESULT="FAILED: image server not reachable at $URL"
        continue
    fi
    t0=$(now)
    if stream /dev/null; then
        t1=$(now)
        RESULT="OK attempt=$attempt duration=$((t1 - t0))s $DD_MSG"
        break
    fi
    RESULT="FAILED attempt=$attempt (wget=$W zstd=$Z dd=$D) ${ZSTD_MSG:+zstd: $ZSTD_MSG}"
    log "dryrun $RESULT"
    sleep 5
done
log "dryrun result: $RESULT"

mount -o rw,remount "$BOOT_PART" /mnt/boot 2>/dev/null || mount "$BOOT_PART" /mnt/boot
{
    echo "url: $URL"
    echo "mac: ${MAC:-unknown}"
    echo "result: $RESULT"
} > /mnt/boot/reflash-dryrun.log
rm -f /mnt/boot/reflash-dryrun
sync
umount /mnt/boot
log "dryrun complete, rebooting into normal system"
reboot -f
